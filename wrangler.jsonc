{
	// Worker "assets + API" : sert les fichiers statiques générés par
	// `next build` (output: 'export', voir next.config.mjs) pour toutes les
	// routes, sauf POST /api/contact intercepté par worker.ts pour appeler
	// Resend côté serveur (formulaire de demande de démonstration).
	"name": "civelo-site-produit",
	"main": "worker.ts",
	"compatibility_date": "2026-09-11",
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		// Sert le vrai fichier 404.html généré par Next (page non trouvée),
		// plutôt que de retomber sur index.html (ce dernier comportement,
		// "single-page-application", ne convient qu'à une SPA côté client).
		"not_found_handling": "404-page"
	}
}
